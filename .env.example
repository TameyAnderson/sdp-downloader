# Token from @BotFather (required)
# Токен від @BotFather (обов'язково)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Telegram user id — update notifications are sent here.
# Find yours: send /id to the bot or use @userinfobot.
# Твій Telegram user id — сюди бот шле сповіщення про оновлення.
# Дізнатись свій: напиши боту /id або скористайся @userinfobot.
ADMIN_ID=0

# How often to check for updates (yt-dlp, aiogram, Cobalt and the repository),
# in minutes. 0 = disable. Editable live in the panel.
# Раз на скільки хвилин перевіряти оновлення (yt-dlp, aiogram, Cobalt і
# репозиторій). 0 = вимкнути. Редагується наживо в панелі.
CHECK_INTERVAL_MINUTES=15

# 1 = pull a fresh yt-dlp on every container start (no image rebuild needed).
# Then a simple restart is enough to update yt-dlp.
# 1 = при старті контейнера автоматично тягнути свіжий yt-dlp (без перезбірки).
# Тоді достатньо перезапустити контейнер, щоб оновити yt-dlp.
AUTO_UPGRADE_YTDLP=1

# Platform switches (1 = on, 0 = off). A disabled platform is ignored entirely:
# the bot does not react to its links.
# Перемикачі платформ (1 = вкл, 0 = викл). Вимкнена платформа повністю
# ігнорується ботом (він не реагує на її силки).
ENABLE_TIKTOK=1
ENABLE_YOUTUBE=1
ENABLE_INSTAGRAM=1
ENABLE_FACEBOOK=1

# Extra services (off by default). Also switchable in Mini App -> Settings ->
# Services. Social networks go through Cobalt (needs ENABLE_COBALT=1),
# video hosts and music through yt-dlp.
# Додаткові сервіси (вимкнені за замовч.). Вмикаються і в Mini App ->
# Налаштування -> Сервіси. Соцмережі йдуть через Cobalt (треба ENABLE_COBALT=1),
# відеохостинги й музика — через yt-dlp.
ENABLE_TWITTER=0
ENABLE_REDDIT=0
ENABLE_PINTEREST=0
ENABLE_TUMBLR=0
ENABLE_SNAPCHAT=0
ENABLE_BLUESKY=0
ENABLE_VIMEO=0
ENABLE_DAILYMOTION=0
ENABLE_BILIBILI=0
ENABLE_TWITCH=0
ENABLE_SOUNDCLOUD=0

# All-in: any site supported by yt-dlp (1500+). Spotify/Deezer read the PUBLIC
# track title and download a match from YouTube (no DRM circumvention).
# All-in: будь-який сайт, що підтримує yt-dlp (1500+). Spotify/Deezer читають
# ПУБЛІЧНУ назву треку й качають збіг з YouTube (без DRM-обходу).
ENABLE_ALLIN=0
ENABLE_SPOTIFY=0
ENABLE_DEEZER=0

# Cobalt (self-hosted). Handles Instagram, Facebook and TikTok photo carousels —
# which is why no Instagram account warming or cookies fiddling is required.
# 1 = enabled. The URL is the internal service name from the stack (port 9010).
# Cobalt (self-hosted). Обробляє Instagram, Facebook і TikTok фото-каруселі —
# завдяки цьому НЕ треба гріти інстаграм-акаунт і возитися з cookies.
# 1 = увімкнено. URL — внутрішнє ім'я сервісу зі стеку (порт 9010, не 9000).
ENABLE_COBALT=1
COBALT_API_URL=http://cobalt-api:9010
# (Optional) A backup Cobalt instance — the last attempt for Instagram/Facebook.
# Only makes sense if it is YOUR second instance on a different IP: public ones
# now sit behind API keys or Turnstile.
# (Необов'язково) резервний Cobalt-інстанс — остання спроба для Instagram/
# Facebook. Має сенс лише якщо це ТВІЙ другий інстанс на іншому IP:
# публічні тепер під API-ключем або Turnstile.
# COBALT_FALLBACK_URL=

# Retry a Cobalt request when the answer is empty or broken (Instagram often
# returns a proper file a few seconds later). Attempts / pause in seconds.
# Повтор запиту до Cobalt, якщо відповідь порожня або бита (Instagram часто
# віддає нормальний файл через кілька секунд). Спроб / пауза в секундах.
COBALT_RETRIES=2
COBALT_RETRY_DELAY=3

# tikwm — a public API, the most reliable source for TikTok photo carousels
# (no accounts needed). Tried first for /photo/ posts. 1 = enabled.
# tikwm — публічний API, найнадійніший для TikTok фото-каруселей (без акаунтів).
# Пробується першим для постів /photo/. 1 = увімкнено.
ENABLE_TIKWM=1
TIKWM_API=https://tikwm.com/api/

# File size limit in MB (Telegram allows 50 for bots).
# Ліміт розміру файлу в МБ (Telegram для ботів = 50).
MAX_FILE_SIZE_MB=50

# ============================================================================
# The values below are DEFAULTS. Nearly all of them are editable live in
# Mini App -> Settings (stored in the database, which takes priority over env):
#   "Load and limits" — FLOOD_MAX_RETRIES, CHAT_SEND_INTERVAL,
#     MAX_LINKS_PER_MESSAGE, MAX_PER_USER, JOB_RETRIES, JOB_RETRY_DELAY,
#     COBALT_RETRIES, COBALT_RETRY_DELAY, MAX_CONCURRENT_DOWNLOADS,
#     CONCURRENT_FRAGMENTS, CHECK_INTERVAL_MINUTES, YTDLP_SLEEP
#   "Quality & behaviour" — MAX_HEIGHT, LONG_MAX_HEIGHT, LONG_MIN_HEIGHT,
#     PLAYLIST_MAX, LONG_JOB_NOTIFY, THUMBNAILS, VERIFY_MEDIA, VERIFY_DEEP
#   "Engines" — ENABLE_COBALT, ENABLE_TIKWM
#   "Cache" — ENABLE_CACHE, CACHE_MAX, CACHE_CLEAR_INTERVAL_DAYS (+ one-tap wipe)
# Change them here only to set the starting point for a fresh deployment.
#
# Значення нижче — ДЕФОЛТИ. Майже все з них міняється наживо в Mini App ->
# Налаштування (зберігається в БД і має пріоритет над env):
#   «Навантаження та ліміти», «Якість і поведінка», «Рушії», «Кеш» —
#   ті самі змінні, що в списку вище.
# Тут їх варто чіпати лише щоб задати стартові значення для нового деплою.
# ============================================================================

# --- Telegram rate limit (~20 messages/min per chat) ---
# --- Ліміт Telegram (~20 повідомлень/хв на чат) ---
# How many times to wait and retry a send on 429 (flood control).
# Скільки разів чекати й повторювати відправку при 429 (flood control).
FLOOD_MAX_RETRIES=5
# Minimum pause between sends to ONE chat, seconds. 0 = no throttle.
# Мінімальна пауза між відправками в ОДИН чат, секунди. 0 = без троттлу.
CHAT_SEND_INTERVAL=1.0

# --- Abuse protection / Захист від зловживань ---
# Maximum links processed from a single message (the rest are ignored).
# Максимум силок, які обробляються з одного повідомлення (решта ігнорується).
MAX_LINKS_PER_MESSAGE=10
# Maximum simultaneous downloads from ONE user.
# Максимум одночасних завантажень від ОДНОГО користувача.
MAX_PER_USER=3
# How many videos to download in parallel in total.
# Скільки відео качати одночасно загалом.
MAX_CONCURRENT_DOWNLOADS=8

# Retry a job on a temporary failure (network/timeout): attempts / pause (sec).
# Повтор завдання при тимчасовій помилці (мережа/таймаут): спроб / пауза (сек).
JOB_RETRIES=1
JOB_RETRY_DELAY=5

# How many fragments of ONE video to fetch in parallel (speeds up YouTube/HLS).
# Скільки фрагментів ОДНОГО відео качати паралельно (прискорює YouTube/HLS).
CONCURRENT_FRAGMENTS=5

# Integrity check before sending: 1 = on.
# Перевірка цілісності перед відправкою: 1 = увімк.
VERIFY_MEDIA=1
# 1 = full decode (slow, most reliable); 0 = quick check (tail only).
# 1 = повний декод (повільно, максимально надійно); 0 = швидка перевірка.
VERIFY_DEEP=0

# Pauses between requests (anti-ban). 0 = off (faster). Turn on if you get blocked.
# Паузи між запитами (антибан). 0 = вимкнено (швидше). Увімкни, якщо блокують.
YTDLP_SLEEP=0
# Custom thumbnail for videos (nicer preview, small time cost). 1 = on.
# Своя мініатюра для відео (гарніше прев'ю, трохи часу). 1 = увімк.
THUMBNAILS=1

# Max height for SHORT videos (TikTok/Reels/Shorts). The ladder bottoms out at 360p.
# Макс. висота КОРОТКИХ відео (TikTok/Reels/Shorts). Мінімум у драбині — 360п.
MAX_HEIGHT=720

# LONG videos (full YouTube in private): from 4K (2160) down, but not below 1080p.
# ДОВГІ відео (повний YouTube у приваті): від 4К (2160) вниз, але не нижче 1080п.
LONG_MAX_HEIGHT=2160
LONG_MIN_HEIGHT=1080

# How many items to take from a playlist.
# Скільки роликів брати з плейлиста.
PLAYLIST_MAX=20

# Say "done" if a download took longer than N seconds (0 = never).
# Сповістити, якщо завантаження тривало довше N секунд (0 = ніколи).
LONG_JOB_NOTIFY=60

# --- Instagram cookies (optional) / Cookies для Instagram (необов'язково) ---
# With cookies yt-dlp can fetch posts that are not served anonymously, and
# AUTOMATICALLY becomes the primary engine for Instagram/Facebook.
# З ними yt-dlp тягне пости, які без логіну не віддаються, і АВТОМАТИЧНО
# стає першим рушієм для Instagram/Facebook.
#
# WARNING: a cookies file is a key to the account (login without a password
# or 2FA). Keep it out of git (.gitignore already covers *cookies*) and use
# a SEPARATE account, never your main one.
# УВАГА: файл cookies = ключ від акаунта (вхід без пароля й 2FA). Тримай його
# поза git і бери ОКРЕМИЙ акаунт, не основний.
#
# Default: /data/cookies.txt (on the botdata volume — survives redeploys).
# The easiest way to install it: send cookies.txt to the bot in private and it
# validates and stores the file itself (/cookies shows the state,
# /cookies delete removes it).
# За замовчуванням: /data/cookies.txt (на volume botdata — переживає передеплой).
# Найпростіший спосіб: надіслати cookies.txt боту в приват — він перевірить
# і збереже сам (/cookies покаже стан, /cookies delete — видалить).
# COOKIES_FILE=/data/cookies.txt
# How many days before expiry to remind about refreshing cookies (0 = never).
# Also editable in Mini App -> Settings -> Cookies.
# За скільки днів до кінця сесії нагадати про оновлення (0 = ніколи).
# Теж міняється в Mini App -> Налаштування -> Cookies.
COOKIES_WARN_DAYS=3
# Maximum size of an accepted cookies file, bytes.
# Максимальний розмір прийнятого файлу cookies, байти.
COOKIES_MAX_BYTES=262144

# (Optional) proxy for region blocks / (Необов'язково) проксі для блокувань
# PROXY=http://user:pass@host:port

# yt-dlp update channel when AUTO_UPGRADE_YTDLP=1: stable | nightly | master.
# nightly/master carry fresh extractor fixes (e.g. a broken TikTok) that have
# not reached a stable release yet.
# Канал оновлення yt-dlp при AUTO_UPGRADE_YTDLP=1: stable | nightly | master.
# nightly/master містять свіжі фікси екстракторів (напр. зламаний TikTok),
# які ще не потрапили у стабільний реліз.
YTDLP_CHANNEL=master

# --- Local Bot API (lift the 50 MB limit to 2 GB), optional ---
# --- Локальний Bot API (зняти ліміт 50 МБ -> 2 ГБ), опційно ---
# 1) Get api_id/api_hash at my.telegram.org.
# 2) Enable the service with the profile: COMPOSE_PROFILES=bigfiles
# 3) Do the one-time logOut (see README), then uncomment TELEGRAM_API_URL.
# 1) Візьми api_id/api_hash на my.telegram.org.
# 2) Увімкни сервіс профілем: COMPOSE_PROFILES=bigfiles
# 3) Одноразовий logOut (див. README), тоді розкоментуй TELEGRAM_API_URL.
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_API_URL=http://telegram-bot-api:8081
# MAX_FILE_SIZE_MB=2000

# --- file_id cache / Кеш file_id ---
# Stores only Telegram file ids, never the videos themselves. Lives on the
# botdata volume. 0 = off (default), 1 = on.
# Зберігає лише id файлів у Telegram, не самі відео. Лежить на volume botdata.
# 0 = вимкнено (за замовч.), 1 = увімкнено.
CACHE_FILE=/data/cache.json
CACHE_MAX=1000
ENABLE_CACHE=0
# Wipe the cache every N days (when the cache is on).
# Автоочистка кешу раз на N днів (коли кеш увімкнено).
CACHE_CLEAR_INTERVAL_DAYS=7

# Port of the internal /health endpoint (healthcheck/autoheal). Not exposed.
# Порт внутрішнього /health ендпоінта (healthcheck/autoheal). Назовні не треба.
HEALTH_PORT=8080

# --- Mini App (Telegram Web App) ---
# 1 = enable the web panel. Requires the miniapp profile
# (COMPOSE_PROFILES=miniapp) + cloudflared for HTTPS.
# 1 = увімкнути веб-панель. Потрібен профіль miniapp
# (COMPOSE_PROFILES=miniapp) + cloudflared для HTTPS.
WEBAPP_ENABLED=0
# Reject Mini App signatures older than N seconds (replay protection). 0 = off.
# Відкидати підписи Mini App, старші за N секунд (захист від replay). 0 = вимк.
WEBAPP_AUTH_TTL=86400

# Cloudflare named tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel).
# Gives a stable HTTPS address on your domain. The route (subdomain ->
# http://video-bot:8080) is configured in the Cloudflare dashboard, not here.
# Токен named-тунелю Cloudflare (Zero Trust -> Networks -> Tunnels -> твій тунель).
# Дає сталу HTTPS-адресу на твоєму домені. Маршрут (піддомен ->
# http://video-bot:8080) налаштовується в дашборді Cloudflare, не тут.
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoixxxxxxxx...

# --- Update notifications / Сповіщення про оновлення ---
# Works out of the box: the bot watches upstream and messages the admin when
# a new version is out — with a change summary and a link to the diff.
# Nothing to configure. Options:
#   GITHUB_REPO=you/fork   — watch your own fork
#   GITHUB_REPO=off        — no notifications at all
# Працює з коробки: бот стежить за апстрімом і пише адміну, коли виходить нова
# версія — з описом змін і посиланням на diff. Нічого вказувати не треба:
#   GITHUB_REPO=свій/форк   — стежити за власним форком
#   GITHUB_REPO=off         — не сповіщати взагалі
# GITHUB_REPO=user/repo
# GITHUB_BRANCH=main
# A token is needed ONLY for a private repository (not for a public one).
# GitHub -> Settings -> Developer settings -> Personal access tokens ->
# Fine-grained tokens: Repository access = this repo only,
# Permissions -> Repository permissions -> Contents = Read-only.
# Токен потрібен ЛИШЕ для приватного репозиторію (для публічного — ні).
# GITHUB_TOKEN=github_pat_xxxxxxxx

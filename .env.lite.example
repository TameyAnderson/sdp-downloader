# s.d.p downloader — LITE
#
# Copy to .env, paste the token — done. Everything else has working defaults.
# Скопіюй у .env, встав токен — і все. Решта має робочі значення.
#
#   cp .env.lite.example .env
#   docker compose -f docker-compose.lite.yml up -d --build

# Token from @BotFather. The only mandatory value.
# Токен від @BotFather. Єдине, що обов'язково.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Where the bot works / Де боту працювати ---
# LITE answers in GROUPS ONLY. Allowed chats: -1001234,-1005678
# Empty = any group it has been added to.
# IMPORTANT: if the bot is public (findable in Telegram search), do not leave
# this empty — anyone could add it and download videos using your server.
# A group tells you its id if you send /id there.
#
# LITE відповідає ТІЛЬКИ в групах. Список дозволених чатів: -1001234,-1005678
# Порожньо = будь-яка група, куди його додали.
# ВАЖЛИВО: якщо бот публічний (є в пошуку Telegram), лишати порожнім не варто —
# його зможе додати собі будь-хто й вантажити відео твоїм сервером.
# Свій id група покаже, якщо написати там /id.
ALLOWED_CHATS=

# --- What to download / Що качати ---
ENABLE_TIKTOK=1
ENABLE_INSTAGRAM=1
ENABLE_YOUTUBE=1
ENABLE_FACEBOOK=0

# Send the audio track as a separate MP3 next to the video (the music under
# the clip).
# Разом із відео надіслати ще й звукову доріжку окремим MP3 (музика з-під ролика).
AUDIO_TOO=0

# Post title as a file caption: off | private | all.
# In groups it is usually noise, hence off by default.
# Підпис із назвою поста під файлом: off | private | all.
# У групах зазвичай зайвий, тому за замовчуванням off.
TITLES_MODE=off

# Quality cap. Above 720 makes little sense: the LITE file limit is 50 MB.
# Стеля якості. Вище 720 сенсу мало: ліміт Telegram у LITE — 50 МБ на файл.
MAX_HEIGHT=720

# Bot message language: uk | en.
# Мова повідомлень бота: uk | en.
BOT_LANG=uk

# --- Optional / За бажанням ---
# Proxy, if your provider blocks something: http://user:pass@host:port
# Проксі, якщо провайдер щось ріже: http://user:pass@host:port
PROXY=

# Instagram cookies (for posts that are not served without a login).
# In LITE the file is only read from the host — it cannot be sent to the bot.
# Uncomment the volume in docker-compose.lite.yml and set the path:
#
# Cookies для Instagram (постів, які без логіну не віддаються).
# У LITE файл лише читається з хоста — надіслати його боту не можна.
# Розкоментуй volume в docker-compose.lite.yml і встав шлях:
# COOKIES_FILE=/cookies.txt
#
# WARNING: a cookies file is a key to the account — login without a password
# or 2FA. Use a SEPARATE account, not your main one, and never commit it.
# УВАГА: файл cookies = ключ від акаунта, вхід без пароля й 2FA.
# Бери ОКРЕМИЙ акаунт, не основний, і не клади файл у git.
COOKIES_FILE=

# Your Telegram id — new-version notifications go there. 0 = do not disturb.
# Find yours with @userinfobot.
# Твій Telegram id — туди прийде сповіщення про нову версію. 0 = не турбувати.
# Дізнатись свій id: @userinfobot.
ADMIN_ID=0

# --- What LITE does not have (and will not) ---
# Mini App, statistics, database, cache, allow lists in a panel, the mp3 mode
# in private, long YouTube videos, playlists, trimming by timestamps.
# Need any of that? Use the full docker-compose.yml and .env.example.
#
# --- Чого в LITE немає (і не буде) ---
# Mini App, статистики, бази, кешу, білих списків через панель, mp3-режиму
# в приваті, довгих відео з YouTube, плейлистів, обрізки за таймкодами.
# Треба щось із цього — бери повний docker-compose.yml і .env.example.
